# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
#
# Stripe keys come from https://dashboard.stripe.com/test/apikeys

DJANGO_SECRET_KEY=<a-long-random-string>
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>

# --- Local development ---
# Turns on tracebacks, disables secure-cookie/HTTPS enforcement, and makes
# ALLOWED_HOSTS default to localhost. Never set this in production.
DJANGO_DEBUG=True


# --- Production (set these in the Railway dashboard, not in this file) ---
#
# DJANGO_SECRET_KEY       required; generate a fresh one, do not reuse the dev key
# STRIPE_SECRET_KEY       required; use live keys only when going live
# STRIPE_PUBLISHABLE_KEY  required
#
# DATABASE_URL            injected automatically by Railway's Postgres addon;
#                         when present it overrides the SQLite config entirely
# RAILWAY_PUBLIC_DOMAIN   injected automatically; added to ALLOWED_HOSTS and
#                         CSRF_TRUSTED_ORIGINS
# DJANGO_ALLOWED_HOSTS    comma-separated; only needed for a custom domain
# MEDIA_ROOT              set to /app/media and mount a Railway volume there,
#                         otherwise every redeploy deletes all uploaded files
# SECURE_HSTS_SECONDS     leave unset until on a custom domain, then 31536000
# WEB_CONCURRENCY         gunicorn worker processes (default 2)
